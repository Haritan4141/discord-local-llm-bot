# ==================================================
# Discord Bot Settings
# ==================================================

# Discord Developer Portal で取得した Bot Token
# ※ 実際の値は絶対に GitHub に commit しないこと
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Application ID / Guild ID（スラッシュコマンド登録用）
CLIENT_ID=your_discord_application_client_id_here
GUILD_ID=your_discord_server_guild_id_here

# Bot が反応するチャンネルID（カンマ区切りで複数指定可）
# 例: 123456789012345678,987654321098765432
CHANNEL_IDS=123456789012345678

# ==================================================
# Local LLM (OpenAI compatible)
# ==================================================

# Provider: ollama, lmstudio, or custom
LLM_PROVIDER=ollama

# OpenAI 互換 API の base URL（通常は /v1 まで）
# Ollama:    http://127.0.0.1:11434/v1
# LM Studio: http://127.0.0.1:1234/v1
LLM_BASE_URL=http://127.0.0.1:11434/v1

# 使用する LLM モデル
# Ollama 例: gemma3:4b, gemma3:12b, llama3.1:8b, qwen3-vl:8b
# LM Studio 例: GUI のモデル一覧から model identifier を選択
LLM_MODEL=gemma3:12b

# Optional: API key（Ollama / LM Studio は通常空でOK）
LLM_API_KEY=

# Optional: Ollama Web Search API key（/webchat 用）
# https://ollama.com で作成した API key を設定
OLLAMA_WEB_API_KEY=

# Legacy fallback（古い設定との互換用。LLM_* が優先されます）
OLLAMA_URL=http://127.0.0.1:11434/v1/chat/completions

OLLAMA_MODEL=gemma3:12b

# システムプロンプト（Botの基本人格）
SYSTEM_PROMPT=あなたはDiscordチャンネルの会話に自然に参加するAIです。日本語で、短めに、空気を読んで返答してください。

# ==================================================
# Stable Diffusion WebUI (AUTOMATIC1111)
# ==================================================

# Stable Diffusion WebUI の URL（--api 付きで起動していること）
SD_WEBUI_URL=http://127.0.0.1:7860
# Remote example:
# SD_WEBUI_URL=http://192.168.1.50:7860
# SD WebUI must be started with: --api --listen

# デフォルト生成設定（/draw で上書き可能）
SD_WIDTH=1024
SD_HEIGHT=1024
SD_STEPS=20
SD_CFG_SCALE=5
SD_SAMPLER=Euler a
SD_BATCH_SIZE=1

# ネガティブプロンプト（品質安定用）
SD_NEGATIVE_PROMPT=lowres, blurry, worst quality, bad anatomy

# Optional: translate Japanese /draw prompts to English before sending to SD
# true を設定すると翻訳が有効 日本語文字を含むプロンプトだけ翻訳
SD_PROMPT_TRANSLATE=true
# Optional: translation model (defaults to LLM_MODEL)
SD_PROMPT_TRANSLATE_MODEL=

# ==================================================
# Music backend
# ==================================================

# music backend: comfyui (default) or ace
MUSIC_BACKEND=comfyui

# ComfyUI backend（MUSIC_BACKEND=comfyui）
COMFY_URL=http://127.0.0.1:8188
# Remote example:
# COMFY_URL=http://192.168.1.51:8188
# ComfyUI must be started with: --listen
# Optional: workflow JSON path (default: ./comfyui/workflows/audio_ace_step_1_5_checkpoint_api.json)
COMFY_WORKFLOW_PATH=

# ACE-Step API backend（MUSIC_BACKEND=ace）
ACE_URL=http://127.0.0.1:8001
ACE_POLL_MS=2000
# Optional: Bearer token. ACESTEP_API_KEY も fallback として使用可能
ACE_API_KEY=

# ==================================================
# Notes
# ==================================================
# 1. このファイルを .env にコピーして使ってください
# 2. .env は GitHub に commit しないでください
# 3. 値を変更したら Bot を再起動してください
