# ==================================================
# Discord Bot Settings
# ==================================================

# Discord Developer Portal で取得した Bot Token
# ※ 実際の値は絶対に GitHub に commit しないこと
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Application ID / Guild ID（ギルドコマンド登録用）
CLIENT_ID=your_discord_application_client_id_here
# GUILD_ID は任意。Register Guild Commands を使う場合に設定
# 複数指定する場合はカンマ区切り
GUILD_ID=your_discord_server_guild_id_here

# Bot が反応するチャンネルID（カンマ区切りで複数指定可）
# 例: 123456789012345678,987654321098765432
CHANNEL_IDS=123456789012345678

# ==================================================
# Local LLM (OpenAI compatible)
# ==================================================

# Provider: ollama, lmstudio, openai, or custom
LLM_PROVIDER=ollama

# OpenAI 互換 API の base URL（通常は /v1 まで）
# Ollama:    http://127.0.0.1:11434/v1
# LM Studio: http://127.0.0.1:1234/v1
# OpenAI:    https://api.openai.com/v1
LLM_BASE_URL=http://127.0.0.1:11434/v1

# 使用する LLM モデル
# Ollama 例: gemma3:4b, gemma3:12b, llama3.1:8b, qwen3-vl:8b
# LM Studio 例: GUI のモデル一覧から model identifier を選択
LLM_MODEL=gemma3:12b

# Optional: temperature for normal chat responses (0.0 to 2.0)
# Lower values are more stable. Default recommended value: 0.4
LLM_TEMPERATURE=0.4

# Optional: maximum number of recent non-system messages kept in channel history
LLM_MAX_HISTORY_MESSAGES=30

# Web search mode: manual = only /webchat, auto = allow search in normal chat
# The official OpenAI API uses the Responses API hosted web_search tool. Other URLs use Ollama Web Search.
WEB_SEARCH_MODE=manual

# OpenAI Responses only: maximum total built-in Web tool calls per response.
# This includes search, open_page, and find_in_page actions. Default: 2
OPENAI_WEB_SEARCH_MAX_TOOL_CALLS=2

# OpenAI Responses only: maximum Sources URLs appended to a Discord response.
# Set 0 to hide the Sources list. Default: 1
OPENAI_WEB_SEARCH_MAX_SOURCES=1

# Optional: automatically include relevant Discord server members in normal chat.
# The bot keeps a member cache and only adds matching members/member summaries to the LLM prompt.
MEMBER_CONTEXT_ENABLED=true
# Cache refresh interval in seconds. Member add/remove/name/presence events update the cache immediately.
MEMBER_CONTEXT_CACHE_TTL_SECONDS=600
# Maximum number of member records included in one LLM prompt.
MEMBER_CONTEXT_MAX_MEMBERS=24
# Maximum characters for the temporary member context included in one LLM prompt.
MEMBER_CONTEXT_MAX_CHARS=6000

# Optional: timezone passed to the LLM as "current date/time" context. Use IANA
# names (Asia/Tokyo, America/New_York, Europe/Berlin, ...). Defaults to Asia/Tokyo.
BOT_TIMEZONE=Asia/Tokyo

# Optional: API key（Ollama / LM Studio は通常空でOK）
LLM_API_KEY=

# Optional: keep the Ollama model loaded in memory longer
# Examples: 30m (30 minutes), 1h (1 hour), 3600 (seconds), -1 (always loaded), 0 (unload immediately)
OLLAMA_KEEP_ALIVE=30m

# Optional: Ollama Web Search API key（OpenAI provider では不要）
# https://ollama.com で作成した API key を設定
OLLAMA_WEB_API_KEY=

# Legacy fallback（古い設定との互換用。LLM_* が優先されます）
OLLAMA_URL=http://127.0.0.1:11434/v1/chat/completions

OLLAMA_MODEL=gemma3:12b

# システムプロンプト（Botの基本人格）
# カスタム値を設定しても、Discordの応答形式ルールは自動的に追加されます。
SYSTEM_PROMPT="あなたはDiscordチャンネルの会話に自然に参加するAIです。日本語で、短めに、空気を読んで、最新の発言に直接返答してください。[Discord response format policy] 返答の先頭に発言者名・ユーザー名・表示名を付けないでください。「名前: 内容」「○○:『内容』」の形式で、ユーザーの発言を復唱・要約しないでください。会話ログや台本の形式ではなく、回答本文だけを返してください。メンバー名は回答に必要な場合だけ、自然な文章の中で使用してください。"

# ==================================================
# Standby Bot (optional)
# ==================================================

# Uses the same DISCORD_TOKEN as the main bot.
# Optional: channels handled while the main bot is stopped. If empty, CHANNEL_IDS is used.
STANDBY_CHANNEL_IDS=

# Optional: fixed reply shown while the main bot is stopped
STANDBY_REPLY_MESSAGE=現在メイン Bot は停止中です。しばらくしてからもう一度試してください。

# Optional: cooldown per user per channel in seconds
STANDBY_REPLY_COOLDOWN_SECONDS=300

# ==================================================
# Image generation (/draw)
# ==================================================

# openai or stable-diffusion
# 未設定時は LLM_PROVIDER=openai なら openai、それ以外は stable-diffusion
IMAGE_PROVIDER=stable-diffusion

# OpenAI Image API（IMAGE_PROVIDER=openai）
OPENAI_IMAGE_MODEL=gpt-image-2
# auto / low / medium / high（料金を抑える既定値は low）
OPENAI_IMAGE_QUALITY=low
# width x height。/draw の width / height で上書き可能
OPENAI_IMAGE_SIZE=1024x1024
# 空欄なら LLM_API_KEY を使用
OPENAI_IMAGE_API_KEY=

# Stable Diffusion WebUI (IMAGE_PROVIDER=stable-diffusion)

# Stable Diffusion WebUI の URL（--api 付きで起動していること）
SD_WEBUI_URL=http://127.0.0.1:7860
# Remote example:
# SD_WEBUI_URL=http://192.168.1.50:7860
# SD WebUI must be started with: --api --listen

# デフォルト生成設定（/draw で上書き可能）
SD_WIDTH=1024
SD_HEIGHT=1024
SD_STEPS=20
SD_CFG_SCALE=5
SD_SAMPLER=Euler a
SD_BATCH_SIZE=1

# ネガティブプロンプト（品質安定用）
SD_NEGATIVE_PROMPT=lowres, blurry, worst quality, bad anatomy

# Optional: translate Japanese /draw prompts to English before sending to SD
# true を設定すると翻訳が有効 日本語文字を含むプロンプトだけ翻訳
SD_PROMPT_TRANSLATE=true
# Optional: translation model (defaults to LLM_MODEL)
SD_PROMPT_TRANSLATE_MODEL=

# ==================================================
# Music backend
# ==================================================

# music backend: comfyui (default) or ace
MUSIC_BACKEND=comfyui

# ComfyUI backend（MUSIC_BACKEND=comfyui）
COMFY_URL=http://127.0.0.1:8188
# Remote example:
# COMFY_URL=http://192.168.1.51:8188
# ComfyUI must be started with: --listen
# Optional: workflow JSON path (default: ./comfyui/workflows/audio_ace_step_1_5_checkpoint_api.json)
COMFY_WORKFLOW_PATH=

# ACE-Step API backend（MUSIC_BACKEND=ace）
ACE_URL=http://127.0.0.1:8001
ACE_POLL_MS=2000
# Optional: Bearer token. ACESTEP_API_KEY も fallback として使用可能
ACE_API_KEY=

# ==================================================
# Notes
# ==================================================
# 1. このファイルを .env にコピーして使ってください
# 2. .env は GitHub に commit しないでください
# 3. 値を変更したら Bot を再起動してください
