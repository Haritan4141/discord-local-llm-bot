{
  "name": "discord-local-llm-bot",
  "version": "1.0.0",
  "description": "Discord bot for chatting with a local LLM and generating media via local backends.",
  "main": "index.mjs",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Haritan4141/discord-local-llm-bot.git"
  },
  "bugs": {
    "url": "https://github.com/Haritan4141/discord-local-llm-bot/issues"
  },
  "homepage": "https://github.com/Haritan4141/discord-local-llm-bot#readme",
  "scripts": {
    "gui": "node gui-server.mjs",
    "start": "node index.mjs",
    "register": "node register-commands.mjs --guild",
    "register:guild": "node register-commands.mjs --guild",
    "register:global": "node register-commands.mjs --global",
    "clear:guild": "node clear-guild-commands.mjs",
    "clear:global": "node clear-global-commands.mjs",
    "check": "node --check index.mjs && node --check gui-server.mjs && node --check register-commands.mjs && node --check clear-guild-commands.mjs && node --check clear-global-commands.mjs",
    "test": "npm run check && node --test tests/"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "llm",
    "ollama",
    "lmstudio",
    "stable-diffusion",
    "comfyui"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3"
  }
}
